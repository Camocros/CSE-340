<header id="top-header">
  <div class="site-listing">
    <a href="/" title="Return to home page">
      <img src="/images/site/icon.png" alt="CSE Motors Logo" id="site-logo">
      <span class="site-name">CSE Motors</span>
    </a>
  </div>
  <div id="tools">
    <% if (locals.loggedin) { %>
      <a href="/account/">Welcome <%= locals.accountData.account_firstname %></a>
      <a title="Click to log out" href="/account/logout">Logout</a>
    <% } else { %>
      <a title="Click to log in" href="/account/login">My Account</a>
    <% } %>
  </div>
</header>