<div class="page-title">
  <h1><%= title %></h1>
</div>
<%- messages() %>

<div class="favorites-container">
  <% if (favorites && favorites.length > 0) { %>
    <table class="favorites-display">
      <thead>
        <tr>
          <th>Image</th>
          <th>Vehicle</th>
          <th>Price</th>
          <th>Date Added</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% favorites.forEach(function(favorite) { %>
          <tr>
            <td>
              <img src="<%= favorite.inv_thumbnail %>" alt="<%= favorite.inv_make %> <%= favorite.inv_model %>" style="max-width: 100px;">
            </td>
            <td>
              <a href="/inv/detail/<%= favorite.inv_id %>">
                <%= favorite.inv_year %> <%= favorite.inv_make %> <%= favorite.inv_model %>
              </a>
            </td>
            <td>$<%= new Intl.NumberFormat("en-US").format(favorite.inv_price) %></td>
            <td><%= new Date(favorite.favorite_date).toLocaleDateString() %></td>
            <td>
              <form action="/favorites/remove" method="POST" style="display:inline;">
                <input type="hidden" name="inv_id" value="<%= favorite.inv_id %>">
                <button type="submit" class="btn btn-danger">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="notice" style="margin-top: 1rem;">You don't have any saved favorites yet. Start browsing the inventory to find your dream vehicle!</p>
  <% } %>
</div>
